// Cloudflare Worker settings for pedalpause.com.
// Workers Builds reads this file on every push to main.
{
  "name": "pedalpause",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only the form endpoints run code; every page and image is served straight from the files.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Keep any plain-text variables set in the Cloudflare dashboard (secrets are always kept).
  "keep_vars": true,

  // Branch builds run `wrangler preview`, which needs this block (it can stay empty).
  "previews": {},

  // KV storage. Deploys replace dashboard bindings with what's listed here, so every KV
  // namespace the site uses must be listed here (see README).
  "kv_namespaces": [
    // Event submissions waiting for review (Storage & Databases > KV > pedalpause-event-submissions)
    { "binding": "EVENT_SUBMISSIONS", "id": "adca1c9a1e5b4fefb43db5355753098e" },
    // Question-box limits: 15 per visitor per hour, 300 per day (pedalpause-rules-chat)
    { "binding": "RULES_CHAT_LIMITS", "id": "b192c811f642408ab89a3ef01752f110" }
  ]
}
